# Real secrets go in a real .env next to this file, created directly on the
# deploy host (rohan-pc) only -- never committed, same convention as this
# repo's own top-level .env/.env.example.

# The Google Cloud OAuth client already registered for google_workspace_mcp
# (unchanged from the existing deployment -- same client, same redirect_uri,
# since this migration keeps the exact same external URL/port).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
